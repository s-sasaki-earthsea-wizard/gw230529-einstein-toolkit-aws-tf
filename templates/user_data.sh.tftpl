#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2026 Syota Sasaki
#
# Node bootstrap for the GW230529 Einstein Toolkit spot instance.
#
# SKELETON. Steps marked TODO(phase4) are stubs to be filled in once the local
# dx=28 run of Phase 2-3 has pinned down the actual run command and directory
# layout. As written the script provisions the node, restores state and starts
# the sidecars, then stops before launching the simulation.
#
# This file is a Terraform template: $${SHELL_VARIABLES} are escaped, while
# $${terraform_values} are substituted at plan time.

set -euo pipefail
exec > >(tee -a /var/log/gw230529-bootstrap.log) 2>&1
echo "=== gw230529 bootstrap started at $(date -Is) ==="

AWS_REGION="${aws_region}"
RUN_MODE="${run_mode}"
IMAGE="${ecr_repository_url}:${image_tag}"
BUCKET="${data_bucket}"
INPUTS_PREFIX="${inputs_prefix}"
RUN_NAME="${run_name}"
PARFILE="${parfile}"
MPI_PROCS="${mpi_procs}"
OMP_THREADS="${omp_threads}"
REHEARSAL_PAYLOAD_GB="${rehearsal_payload_gb}"
SYNC_INTERVAL_MIN="${sync_interval_minutes}"
AUTO_SHUTDOWN="${auto_shutdown}"

WORK_DIR=/opt/gw230529
S3_RUN="s3://$${BUCKET}/$${RUN_NAME}"
S3_INPUTS="s3://$${BUCKET}/$${INPUTS_PREFIX}"

# Paths inside the container. The gallery parfile sets
# IO::checkpoint_dir = "../CHECKPOINTS", relative to the run's working
# directory, so with a run directory of
#   /home/etuser/simulations/<run_name>/run
# checkpoints land in
#   /home/etuser/simulations/<run_name>/CHECKPOINTS
# The parfile is left alone and the bind mount is placed where it points.
# Nesting the checkpoint mount inside the simulations mount keeps the two
# apart on the host, which is what lets the sidecar treat them differently.
C_SIM_ROOT=/home/etuser/simulations
C_RUN_PARENT="$${C_SIM_ROOT}/$${RUN_NAME}"
C_RUN_DIR="$${C_RUN_PARENT}/run"
C_CKPT_DIR="$${C_RUN_PARENT}/CHECKPOINTS"
C_INPUTS=/home/etuser/inputs

export AWS_DEFAULT_REGION="$${AWS_REGION}"

# ------------------------------------------------------------------
# 1. Packages
# ------------------------------------------------------------------
dnf -y update
dnf -y install docker awscli-2 jq

systemctl enable --now docker

mkdir -p "$${WORK_DIR}"/{simulations,checkpoints,inputs,logs}
mkdir -p "$${WORK_DIR}/simulations/$${RUN_NAME}/run"

# ------------------------------------------------------------------
# 2. Pull the Einstein Toolkit image from ECR
#
# Only for a real run. The ops rehearsal writes a synthetic payload with dd
# and never enters the container, so pulling 5-8 GB would buy nothing -- and
# on a repository that has not been pushed to yet, `docker pull` fails under
# `set -e`, which aborts the bootstrap before the shutdown at the end of this
# script. The instance would then sit idle and billing with nothing running.
# ------------------------------------------------------------------
if [ "$${RUN_MODE}" = "simulation" ]; then
  aws ecr get-login-password --region "$${AWS_REGION}" \
    | docker login --username AWS --password-stdin "${ecr_repository_url}"
  docker pull "$${IMAGE}"
else
  echo "run_mode=$${RUN_MODE}: skipping the ECR pull, no container is used"
fi

# ------------------------------------------------------------------
# 2b. Fetch the parfile and the FUKA initial data
#
# These are Einstein Toolkit gallery artefacts. They are not redistributable,
# so they are neither committed nor baked into the image -- the simulation
# repository keeps them in a gitignored upstream/ that is also excluded from
# the Docker build context. Locally they are visible only because the whole
# repository is bind mounted, which is a mount source this machine does not
# have. Four files, 1.6 MB, fetched from the private bucket instead.
#
# Keeping them out of ECR also means a mis-set repository visibility cannot
# republish upstream copyrighted data.
# ------------------------------------------------------------------
if [ "$${RUN_MODE}" = "simulation" ]; then
  aws s3 sync "$${S3_INPUTS}/" "$${WORK_DIR}/inputs/" --only-show-errors

  if [ ! -f "$${WORK_DIR}/inputs/$${PARFILE}" ]; then
    echo "FATAL: $${PARFILE} not found under $${S3_INPUTS}/"
    echo "Run 'make upload-inputs' before launching a simulation."
    exit 1
  fi

  # The FUKA .info file carries an absolute path to the EOS table, which the
  # upstream distribution ships as the literal placeholder /path/to/. Rewrite
  # it to wherever the inputs happen to be mounted rather than requiring the
  # container layout to match whatever the file was last edited for.
  #
  # The key is indented in the file, so the anchor has to allow leading
  # whitespace; the second expression covers a bare filename with no directory
  # part. Both keep the original indentation through \1.
  for info in "$${WORK_DIR}"/inputs/*.info; do
    [ -f "$${info}" ] || continue
    sed -i -E \
      -e "s|^([[:space:]]*eosfile[[:space:]]+).*/([^/[:space:]]+)[[:space:]]*$|\1$${C_INPUTS}/\2|" \
      -e "s|^([[:space:]]*eosfile[[:space:]]+)([^/[:space:]]+)[[:space:]]*$|\1$${C_INPUTS}/\2|" \
      "$${info}"
    echo "$(basename "$${info}"): $(grep -E '^[[:space:]]*eosfile' "$${info}" || echo 'no eosfile key')"
  done

  if ! grep -qE "^[[:space:]]*eosfile[[:space:]]+$${C_INPUTS}/" "$${WORK_DIR}"/inputs/*.info; then
    echo "FATAL: eosfile path rewrite did not take; the run would abort on the EOS table"
    exit 1
  fi
fi

# ------------------------------------------------------------------
# 3. Restore any previous state
#
# The bucket is the system of record. On a fresh launch these prefixes are
# empty and the sync is a no-op; after a spot interruption they hold the last
# checkpoint written before the instance was reclaimed.
# ------------------------------------------------------------------
# Checkpoints live in two alternating slots with a CURRENT marker naming the
# one that finished uploading. Restore reads the marker, never the newest
# timestamp, so a set that was still uploading when the instance was reclaimed
# can never be recovered from.
CURRENT_SLOT="$(aws s3 cp "$${S3_RUN}/checkpoints/CURRENT" - 2>/dev/null || true)"
if [ -n "$${CURRENT_SLOT}" ]; then
  echo "restoring checkpoints from $${CURRENT_SLOT}"
  aws s3 sync "$${S3_RUN}/checkpoints/$${CURRENT_SLOT}/" "$${WORK_DIR}/checkpoints/" --only-show-errors
else
  echo "no CURRENT marker; starting from scratch"
fi
aws s3 sync "$${S3_RUN}/output/" "$${WORK_DIR}/simulations/" --only-show-errors

# ------------------------------------------------------------------
# 4. Sidecar: periodic sync to S3
#
# Two design points, both driven by the Phase 2 measurement that a production
# checkpoint is about 78 GB across one file per MPI rank.
#
# Double buffering. A push-only mirror of every checkpoint generation would
# accumulate 76 generations over a 76 hour run -- 5.9 TB, roughly 31 USD until
# the lifecycle rule expires it, which is 10% of the project budget. Writing
# alternately into slot-a and slot-b holds S3 at two generations, about 156 GB.
#
# TODO(phase5): this bounds S3 only. Phase 2 found that IO::checkpoint_keep
# does not prune across runs -- two runs left three generations, 77 GB, on
# disk. At 78 GB each, a 500 GB root volume fills after six, which a run
# resumed a few times will reach. The sidecar needs to drop every local
# generation except the one CURRENT names and the one being written.
#
# The CURRENT marker. Uploading 78 GB takes minutes, and an instance reclaimed
# part way through leaves a torn set in S3. Without a marker, restore plus
# `recover = autoprobe` would select it precisely because it is the newest.
# The marker is written only after the upload returns success, so it always
# names a complete set.
#
# Output is pushed separately and additively: it only grows, and losing a
# diagnostic file matters far less than losing the ability to restart.
# ------------------------------------------------------------------
cat > /usr/local/bin/gw230529-sync <<SYNC
#!/usr/bin/env bash
set -euo pipefail
export AWS_DEFAULT_REGION="$${AWS_REGION}"

CKPT_DIR="$${WORK_DIR}/checkpoints"
S3_CKPT="$${S3_RUN}/checkpoints"

# Diagnostic output first: cheap, additive, and never blocks a restart.
# CHECKPOINTS is excluded as a guard: it should be empty on the host because
# the checkpoint bind mount shadows it, but if that mount is ever missing the
# exclusion is what stops 78 GB being uploaded a second time under output/.
aws s3 sync "$${WORK_DIR}/simulations/" "$${S3_RUN}/output/" \
  --exclude '*/CHECKPOINTS/*' --only-show-errors

# TODO(phase4): replace with a real completeness test once Phase 2-3 has
# pinned down the checkpoint file naming and the rank count. The set is
# complete when it holds exactly \$MPI_PROCS files for the same iteration and
# none of them has been modified in the last 30 seconds. Syncing a set that
# Cactus is still writing is the one failure this whole design exists to
# prevent, so this predicate must be conservative: when in doubt, skip and
# let the next tick handle it.
newest=\$(find "\$${CKPT_DIR}" -name '*.h5' -newermt '-30 seconds' -print -quit 2>/dev/null || true)
if [ -n "\$${newest}" ]; then
  echo "checkpoint still being written; skipping this tick"
  exit 0
fi

# Nothing new since the last successful push?
STAMP=/var/lib/gw230529/last-synced-checkpoint
mkdir -p "\$(dirname "\$${STAMP}")"
signature=\$(find "\$${CKPT_DIR}" -name '*.h5' -printf '%p %s %T@\n' 2>/dev/null | sort | sha256sum)
if [ -f "\$${STAMP}" ] && [ "\$(cat "\$${STAMP}")" = "\$${signature}" ]; then
  exit 0
fi

current=\$(aws s3 cp "\$${S3_CKPT}/CURRENT" - 2>/dev/null || true)
if [ "\$${current}" = "slot-a" ]; then target=slot-b; else target=slot-a; fi

echo "pushing checkpoints to \$${target}"
aws s3 sync "\$${CKPT_DIR}/" "\$${S3_CKPT}/\$${target}/" --delete --only-show-errors

# Only now is the slot known good.
printf '%s' "\$${target}" | aws s3 cp - "\$${S3_CKPT}/CURRENT" --only-show-errors
printf '%s' "\$${signature}" > "\$${STAMP}"
echo "CURRENT is now \$${target}"
SYNC
chmod +x /usr/local/bin/gw230529-sync

cat > /etc/systemd/system/gw230529-sync.service <<UNIT
[Unit]
Description=Sync GW230529 checkpoints and output to S3

[Service]
Type=oneshot
ExecStart=/usr/local/bin/gw230529-sync
UNIT

cat > /etc/systemd/system/gw230529-sync.timer <<UNIT
[Unit]
Description=Periodic S3 sync for the GW230529 run

[Timer]
OnBootSec=$${SYNC_INTERVAL_MIN}min
OnUnitActiveSec=$${SYNC_INTERVAL_MIN}min
AccuracySec=1min

[Install]
WantedBy=timers.target
UNIT

# ------------------------------------------------------------------
# 5. Sidecar: heartbeat
#
# TODO(phase4): publish physical_time parsed from the Cactus stdout alongside
# the memory figures, so run progress is visible without opening a session.
# ------------------------------------------------------------------
cat > /usr/local/bin/gw230529-heartbeat <<HB
#!/usr/bin/env bash
set -euo pipefail
export AWS_DEFAULT_REGION="$${AWS_REGION}"
TOKEN=\$(curl -sX PUT http://169.254.169.254/latest/api/token \
  -H "X-aws-ec2-metadata-token-ttl-seconds: 60")
IID=\$(curl -sH "X-aws-ec2-metadata-token: \$${TOKEN}" \
  http://169.254.169.254/latest/meta-data/instance-id)
jq -n \
  --arg ts "\$(date -Is)" \
  --arg iid "\$${IID}" \
  --arg mem "\$(free -g | awk '/^Mem:/ {print \$3"/"\$2" GiB"}')" \
  --arg disk "\$(df -h $${WORK_DIR} | awk 'NR==2 {print \$5}')" \
  '{timestamp: \$ts, instance_id: \$iid, memory: \$mem, disk_used: \$disk}' \
  | aws s3 cp - "$${S3_RUN}/heartbeat/latest.json" --only-show-errors
HB
chmod +x /usr/local/bin/gw230529-heartbeat

cat > /etc/systemd/system/gw230529-heartbeat.service <<UNIT
[Unit]
Description=Publish a GW230529 run heartbeat to S3

[Service]
Type=oneshot
ExecStart=/usr/local/bin/gw230529-heartbeat
UNIT

cat > /etc/systemd/system/gw230529-heartbeat.timer <<UNIT
[Unit]
Description=Periodic GW230529 heartbeat

[Timer]
OnBootSec=5min
OnUnitActiveSec=5min

[Install]
WantedBy=timers.target
UNIT

# ------------------------------------------------------------------
# 6. Sidecar: spot interruption watcher
#
# The warning gives roughly two minutes. A fresh 78 GB checkpoint can be
# neither written nor uploaded in that window, so the handler only flushes
# what is already on disk -- it must not ask Cactus for a new checkpoint.
#
# It runs the ordinary sync, which means it inherits the same refusal to
# upload a checkpoint set that is still being written. If Cactus happens to be
# mid-checkpoint when the notice arrives, the run falls back to the previous
# complete generation. Losing an hour of evolution beats restoring from a torn
# checkpoint and discovering it hours later.
# ------------------------------------------------------------------
cat > /usr/local/bin/gw230529-spot-watch <<WATCH
#!/usr/bin/env bash
set -euo pipefail
export AWS_DEFAULT_REGION="$${AWS_REGION}"
while true; do
  TOKEN=\$(curl -sX PUT http://169.254.169.254/latest/api/token \
    -H "X-aws-ec2-metadata-token-ttl-seconds: 60")
  CODE=\$(curl -so /dev/null -w '%%{http_code}' \
    -H "X-aws-ec2-metadata-token: \$${TOKEN}" \
    http://169.254.169.254/latest/meta-data/spot/instance-action)
  if [ "\$${CODE}" = "200" ]; then
    logger -t gw230529 "spot interruption notice received, flushing to S3"
    /usr/local/bin/gw230529-sync || true
    break
  fi
  sleep 5
done
WATCH
chmod +x /usr/local/bin/gw230529-spot-watch

cat > /etc/systemd/system/gw230529-spot-watch.service <<UNIT
[Unit]
Description=Flush the GW230529 run to S3 on a spot interruption warning

[Service]
Type=simple
Restart=always
ExecStart=/usr/local/bin/gw230529-spot-watch

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now gw230529-sync.timer
systemctl enable --now gw230529-heartbeat.timer
systemctl enable --now gw230529-spot-watch.service

# ------------------------------------------------------------------
# 7. Run
# ------------------------------------------------------------------
RUN_STATUS=0

if [ "$${RUN_MODE}" = "ops-rehearsal" ]; then
  # ----------------------------------------------------------------
  # Ops rehearsal: no physics.
  #
  # Phase 4 proves the operations loop -- slot rotation, the CURRENT marker,
  # interruption flush, restore -- and the Phase 2 numbers say a 16 GiB
  # instance cannot also do physics. The working set at dx=28 is 37.1 GB
  # measured; dx=33.6 still wants 21-26 GB; dx=67.2 fits but dies with
  # "GRHayL: u^0 evaluated to NaN" on the first evolution step, because the
  # CarpetRegrid2 radii are fixed in M and a coarser dx leaves level 1 with
  # 17 cells against the 62 the production grid has -- less than the ghost
  # zones and prolongation buffers consume.
  #
  # So this writes a payload shaped like a checkpoint set instead: one file
  # per rank, rewritten periodically, which is exactly what the sidecar has
  # to cope with. Cheap, interruptible at will, and it exercises every code
  # path that matters here.
  # ----------------------------------------------------------------
  echo "ops-rehearsal: generating a $${REHEARSAL_PAYLOAD_GB} GB synthetic checkpoint set"
  per_file_mb=$(( REHEARSAL_PAYLOAD_GB * 1024 / MPI_PROCS ))

  for generation in 1 2 3; do
    echo "rehearsal generation $${generation}: $${MPI_PROCS} files x $${per_file_mb} MB"
    rm -f "$${WORK_DIR}"/checkpoints/*.h5
    for rank in $(seq 0 $(( MPI_PROCS - 1 ))); do
      dd if=/dev/urandom \
         of="$${WORK_DIR}/checkpoints/checkpoint.chkpt.it_$${generation}.file_$${rank}.h5" \
         bs=1M count="$${per_file_mb}" status=none
    done
    date -Is > "$${WORK_DIR}/simulations/$${RUN_NAME}/run/rehearsal.log"
    echo "generation $${generation} written; waiting for the sidecar to push it"
    sleep 600
  done
  echo "ops-rehearsal complete"
else
  # ----------------------------------------------------------------
  # Simulation.
  #
  # The checkpoint mount is nested inside the simulations mount so that it
  # lands exactly where the parfile's relative ../CHECKPOINTS resolves, while
  # staying a separate directory on the host. Do not "simplify" this by
  # dropping the inner mount: the sidecar would then treat 78 GB of
  # checkpoints as diagnostic output.
  #
  # TODO(phase4): confirm the mpirun invocation and the in-image path to
  # cactus_sim against the built image. Everything else here is settled --
  # Phase 2 verified np=16 checkpoint writes with no POSIX lock errors, one
  # HDF5 file per rank, so the reference pure-MPI shape holds.
  # ----------------------------------------------------------------
  echo "simulation: $${IMAGE} parfile=$${PARFILE} np=$${MPI_PROCS} omp=$${OMP_THREADS}"

  docker run --rm \
    --shm-size=8g \
    -e OMP_NUM_THREADS="$${OMP_THREADS}" \
    -v "$${WORK_DIR}/simulations:$${C_SIM_ROOT}" \
    -v "$${WORK_DIR}/checkpoints:$${C_CKPT_DIR}" \
    -v "$${WORK_DIR}/inputs:$${C_INPUTS}:ro" \
    -w "$${C_RUN_DIR}" \
    "$${IMAGE}" \
    mpirun -np "$${MPI_PROCS}" cactus_sim "$${C_INPUTS}/$${PARFILE}" \
    || RUN_STATUS=$?

  echo "simulation exited with status $${RUN_STATUS}"
fi

# ------------------------------------------------------------------
# 8. Final sync and self-termination
#
# instance_initiated_shutdown_behavior is "terminate", so the poweroff below
# ends billing. This is the real cost guard: budget alerts lag by 8-24 hours
# and cannot stop anything.
# ------------------------------------------------------------------
/usr/local/bin/gw230529-sync
echo "=== gw230529 bootstrap finished at $(date -Is), status=$${RUN_STATUS} ==="

if [ "$${AUTO_SHUTDOWN}" = "true" ]; then
  shutdown -h +1 "GW230529 run complete, terminating"
fi
