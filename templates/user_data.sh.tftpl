#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2026 Syota Sasaki
#
# Node bootstrap for the GW230529 Einstein Toolkit spot instance.
#
# SKELETON. Steps marked TODO(phase4) are stubs to be filled in once the local
# dx=28 run of Phase 2-3 has pinned down the actual run command and directory
# layout. As written the script provisions the node, restores state and starts
# the sidecars, then stops before launching the simulation.
#
# This file is a Terraform template: $${SHELL_VARIABLES} are escaped, while
# $${terraform_values} are substituted at plan time.

set -euo pipefail

# Prefix every line of the node's output with the wall clock time at which it
# was read.
#
# Cactus writes no timestamps of its own. Carpet::physical_time_per_hour does
# appear in the run log, but it is a trailing average over
# Carpet::timing_average_window_minutes and it says nothing about the phases
# either side of the evolution -- the FUKA import, the checkpoint writes, the
# ECR pull. Without a clock in the log those can only be inferred from the S3
# sync timestamps around the run, which is exactly how the dx=28 throughput
# figure ended up recorded as a range of 4.5-10 sec/iter rather than a value.
#
# gawk rather than `ts` from moreutils, which Amazon Linux does not package.
# It is in the base AMI, and section 1 installs it explicitly; the passthrough
# fallback exists because an unstamped log still beats a bootstrap that dies
# for want of a formatting tool.
#
# Idempotent: a line that already carries a stamp is passed through untouched.
# The Cactus pipeline in section 7 stamps its own stream so that the run log
# under output/ carries the clock too, and that same stream then flows through
# this filter on its way to the bootstrap log. Without the guard every Cactus
# line would arrive in the bootstrap log wearing two timestamps.
#
# fflush on every line, or the log reaches S3 in 4 KB bursts and a run in
# flight cannot be watched.
stamp() {
  if ! command -v gawk >/dev/null 2>&1; then
    cat
    return
  fi
  gawk '{
    if (substr($0, 1, 1) == "[" && substr($0, 22, 1) == "]") {
      print
    } else {
      printf "[%s] %s\n", strftime("%Y-%m-%dT%H:%M:%SZ", systime(), 1), $0
    }
    fflush()
  }'
}

exec > >(stamp | tee -a /var/log/gw230529-bootstrap.log) 2>&1
echo "=== gw230529 bootstrap started at $(date -Is) ==="

AWS_REGION="${aws_region}"
RUN_MODE="${run_mode}"

# A tag joins with ":", a digest with "@". Pinning by digest is what makes a
# multi-day spot run deterministic: with a mutable tag, a node relaunched
# after an interruption pulls whatever the tag points at *then*, which after
# an image push mid-run would recover a checkpoint into a different build.
IMAGE_REF="${image_tag}"
case "$${IMAGE_REF}" in
  sha256:*) IMAGE="${ecr_repository_url}@$${IMAGE_REF}" ;;
  *)        IMAGE="${ecr_repository_url}:$${IMAGE_REF}" ;;
esac
BUCKET="${data_bucket}"
INPUTS_PREFIX="${inputs_prefix}"
RUN_NAME="${run_name}"
PARFILE="${parfile}"
MPI_PROCS="${mpi_procs}"
OMP_THREADS="${omp_threads}"
REHEARSAL_PAYLOAD_GB="${rehearsal_payload_gb}"
REHEARSAL_GENERATIONS="${rehearsal_generations}"
CHECKPOINT_GENERATIONS_KEPT="${checkpoint_generations_kept}"
SYNC_INTERVAL_MIN="${sync_interval_minutes}"
AUTO_SHUTDOWN="${auto_shutdown}"

WORK_DIR=/opt/gw230529

# S3 keys put the category first and the run name second:
#
#   checkpoints/<run_name>/...   output/<run_name>/...
#   heartbeat/<run_name>/...     logs/<run_name>/...
#
# The bucket's lifecycle rules match on top-level prefixes, and S3 lifecycle
# filters have no other way to match -- no suffix, no tag on a prefix. The
# previous layout (<run_name>/checkpoints/...) silently pushed every managed
# prefix one level down, so every expiration rule matched nothing and 349 GB
# of dead checkpoints sat in the bucket with no expiry (issue #17). This
# ordering is what makes the rules in modules/storage actually fire.
S3_CKPT="s3://$${BUCKET}/checkpoints/$${RUN_NAME}"
S3_OUTPUT="s3://$${BUCKET}/output/$${RUN_NAME}"
S3_HEARTBEAT="s3://$${BUCKET}/heartbeat/$${RUN_NAME}"
S3_LOGS="s3://$${BUCKET}/logs/$${RUN_NAME}"
S3_INPUTS="s3://$${BUCKET}/$${INPUTS_PREFIX}"

# Paths inside the container. The gallery parfile sets
# IO::checkpoint_dir = "../CHECKPOINTS", relative to the run's working
# directory, so with a run directory of
#   /home/etuser/simulations/<run_name>/run
# checkpoints land in
#   /home/etuser/simulations/<run_name>/CHECKPOINTS
# The parfile is left alone and the bind mount is placed where it points.
# Nesting the checkpoint mount inside the simulations mount keeps the two
# apart on the host, which is what lets the sidecar treat them differently.
C_SIM_ROOT=/home/etuser/simulations
C_RUN_PARENT="$${C_SIM_ROOT}/$${RUN_NAME}"
C_RUN_DIR="$${C_RUN_PARENT}/run"
C_CKPT_DIR="$${C_RUN_PARENT}/CHECKPOINTS"
C_INPUTS=/home/etuser/inputs

# Absolute, because it is not on PATH. The image sets no ENV PATH beyond the
# distribution default, so the 988 MB binary at this location is invisible to
# a bare `cactus_sim`. Verified against gw230529-et:local on 2026-08-20.
CACTUS_EXE=/home/etuser/Cactus/exe/cactus_sim

export AWS_DEFAULT_REGION="$${AWS_REGION}"

# ------------------------------------------------------------------
# 1. Packages
# ------------------------------------------------------------------
dnf -y update
# gawk for the line stamper defined at the top of this script. It is in the
# base AMI already; naming it here keeps the dependency visible.
dnf -y install docker awscli-2 jq gawk

systemctl enable --now docker

mkdir -p "$${WORK_DIR}"/{simulations,checkpoints,inputs,logs}
mkdir -p "$${WORK_DIR}/simulations/$${RUN_NAME}/run"

# The instance's own id, fetched once and baked into the sidecar below. It
# keys the bootstrap log in S3: a rerun under the same run_name must land
# beside its predecessor's log, not on top of it (#9). The bucket has
# versioning off by design, so an overwrite there is unrecoverable -- the
# 2026-08-21 throughput log, the primary evidence for the sec/iter figure,
# was lost exactly this way.
IMDS_TOKEN="$(curl -sX PUT http://169.254.169.254/latest/api/token \
  -H "X-aws-ec2-metadata-token-ttl-seconds: 60")"
INSTANCE_ID="$(curl -sH "X-aws-ec2-metadata-token: $${IMDS_TOKEN}" \
  http://169.254.169.254/latest/meta-data/instance-id)"
echo "instance id $${INSTANCE_ID}"

# ------------------------------------------------------------------
# 2. Pull the Einstein Toolkit image from ECR
#
# Only for a real run. The ops rehearsal writes a synthetic payload with dd
# and never enters the container, so pulling 4.06 GB would buy nothing -- and
# on a repository that has not been pushed to yet, `docker pull` fails under
# `set -e`, which aborts the bootstrap before the shutdown at the end of this
# script. The instance would then sit idle and billing with nothing running.
# ------------------------------------------------------------------
if [ "$${RUN_MODE}" = "simulation" ]; then
  aws ecr get-login-password --region "$${AWS_REGION}" \
    | docker login --username AWS --password-stdin "${ecr_repository_url}"
  docker pull "$${IMAGE}"
else
  echo "run_mode=$${RUN_MODE}: skipping the ECR pull, no container is used"
fi

# ------------------------------------------------------------------
# 2b. Fetch the parfile and the FUKA initial data
#
# These are Einstein Toolkit gallery artefacts. They are not redistributable,
# so they are neither committed nor baked into the image -- the simulation
# repository keeps them in a gitignored upstream/ that is also excluded from
# the Docker build context. Locally they are visible only because the whole
# repository is bind mounted, which is a mount source this machine does not
# have. Four files, 1.6 MB, fetched from the private bucket instead.
#
# Keeping them out of ECR also means a mis-set repository visibility cannot
# republish upstream copyrighted data.
# ------------------------------------------------------------------
if [ "$${RUN_MODE}" = "simulation" ]; then
  aws s3 sync "$${S3_INPUTS}/" "$${WORK_DIR}/inputs/" --only-show-errors

  if [ ! -f "$${WORK_DIR}/inputs/$${PARFILE}" ]; then
    echo "FATAL: $${PARFILE} not found under $${S3_INPUTS}/"
    echo "Run 'make upload-inputs' before launching a simulation."
    exit 1
  fi

  # The FUKA .info file carries an absolute path to the EOS table, which the
  # upstream distribution ships as the literal placeholder /path/to/. Rewrite
  # it to wherever the inputs happen to be mounted rather than requiring the
  # container layout to match whatever the file was last edited for.
  #
  # The key is indented in the file, so the anchor has to allow leading
  # whitespace; the second expression covers a bare filename with no directory
  # part. Both keep the original indentation through \1.
  for info in "$${WORK_DIR}"/inputs/*.info; do
    [ -f "$${info}" ] || continue
    sed -i -E \
      -e "s|^([[:space:]]*eosfile[[:space:]]+).*/([^/[:space:]]+)[[:space:]]*$|\1$${C_INPUTS}/\2|" \
      -e "s|^([[:space:]]*eosfile[[:space:]]+)([^/[:space:]]+)[[:space:]]*$|\1$${C_INPUTS}/\2|" \
      "$${info}"
    echo "$(basename "$${info}"): $(grep -E '^[[:space:]]*eosfile' "$${info}" || echo 'no eosfile key')"
  done

  if ! grep -qE "^[[:space:]]*eosfile[[:space:]]+$${C_INPUTS}/" "$${WORK_DIR}"/inputs/*.info; then
    echo "FATAL: eosfile path rewrite did not take; the run would abort on the EOS table"
    exit 1
  fi

  # The parfile carries a second copy of the same placeholder: it points
  # KadathImporter at the .info file by absolute path, and the gallery ships
  # that as /path/to/ as well. Fixing the .info alone is not enough -- Cactus
  # reads the parfile first, so this is the one that decides whether the run
  # starts at all.
  #
  # Only the basename survives the rewrite. Where the initial data lives is
  # this script's decision (it chose the mount point), not the gallery's.
  # Two expressions for the same reason as the .info rewrite above: the second
  # covers a value that is already a bare filename, which a parfile generated
  # elsewhere may well carry.
  sed -i -E \
    -e "s|^([[:space:]]*kadathimporter::filename[[:space:]]*=[[:space:]]*\")[^\"]*/([^\"/]+)(\")|\1$${C_INPUTS}/\2\3|I" \
    -e "s|^([[:space:]]*kadathimporter::filename[[:space:]]*=[[:space:]]*\")([^\"/]+)(\")|\1$${C_INPUTS}/\2\3|I" \
    "$${WORK_DIR}/inputs/$${PARFILE}"

  ID_INFO="$(sed -nE 's|^[[:space:]]*kadathimporter::filename[[:space:]]*=[[:space:]]*"([^"]*)".*|\1|Ip' \
    "$${WORK_DIR}/inputs/$${PARFILE}" | head -1)"
  echo "kadathimporter::filename: $${ID_INFO:-<absent>}"

  case "$${ID_INFO}" in
    "$${C_INPUTS}/"*) ;;
    *)
      echo "FATAL: initial data path rewrite did not take; the run would abort on the import"
      exit 1
      ;;
  esac

  # Rewriting the directory is worthless if the file it now names was never
  # uploaded, and that failure surfaces only after the container has started.
  if [ ! -f "$${WORK_DIR}/inputs/$${ID_INFO##*/}" ]; then
    echo "FATAL: $${ID_INFO##*/} is not among the files under $${S3_INPUTS}/"
    ls -1 "$${WORK_DIR}/inputs/"
    exit 1
  fi
fi

# ------------------------------------------------------------------
# 3. Restore any previous state
#
# The bucket is the system of record. On a fresh launch these prefixes are
# empty and the sync is a no-op; after a spot interruption they hold the last
# checkpoint written before the instance was reclaimed.
# ------------------------------------------------------------------
# Checkpoints live in two alternating slots with a CURRENT marker naming the
# one that finished uploading. Restore reads the marker, never the newest
# timestamp, so a set that was still uploading when the instance was reclaimed
# can never be recovered from.
CURRENT_SLOT="$(aws s3 cp "$${S3_CKPT}/CURRENT" - 2>/dev/null || true)"
if [ -n "$${CURRENT_SLOT}" ]; then
  echo "restoring checkpoints from $${CURRENT_SLOT}"
  aws s3 sync "$${S3_CKPT}/$${CURRENT_SLOT}/" "$${WORK_DIR}/checkpoints/" --only-show-errors
else
  echo "no CURRENT marker; starting from scratch"
fi
aws s3 sync "$${S3_OUTPUT}/" "$${WORK_DIR}/simulations/$${RUN_NAME}/" --only-show-errors

# Forget everything the restore just read, before anything allocates.
#
# This one line is worth a factor of two on every recovered run. Measured on
# 2026-08-26 (issue #11): a run restored from S3 evolved at 7-12 sec/iter
# against the 3.75-4.16 a fresh run of the identical parfile reaches at the
# identical iterations. Dropping the cache mid-run took it straight back to
# 3.5-4.0 within six minutes, which is what turns this from a theory into a
# cause.
#
# The mechanism is an ordering accident, and only recovery has the ordering:
#
#   1. The restore above pulls 162 GiB of checkpoints onto the volume. Every
#      byte lands in the page cache on its way through, and a c7a.48xlarge is
#      two NUMA nodes of 184 GiB, so one of them fills completely.
#   2. Cactus then allocates 208 GiB. vm.zone_reclaim_mode is 0 by default,
#      which means a node with no free memory does not reclaim its own clean
#      page cache -- it satisfies the allocation from the other node. So
#      first touch places the memory remotely and there it stays.
#   3. Measured on the node: node0 held 115 GiB of file pages and 68 GiB of
#      anonymous memory, node1 held 6 and 140. Half the ranks run on node0's
#      cores with about 35% of their working set across the interconnect,
#      and this is a bandwidth bound stencil.
#   4. AutoNUMA notices and cannot fix it -- 150 GiB of pages migrated with
#      nowhere to land. That churn is itself part of the cost.
#
# A fresh run never hits this because initial data is generated into clean
# memory. That is the whole reason the fault survived Phase 5 unnoticed until
# a recovery was measured.
#
# What it costs: the recovery read of the newest generation (85.7 GiB) now
# comes off the volume rather than out of the cache, about 86 seconds at the
# 1000 MB/s the gp3 is provisioned for, and Docker re-reads the image layers
# it has already pulled, a few seconds more. Both are paid once.
#
# "1" is page cache only; dentries and inodes are not the problem and are
# cheap to keep. It has to happen here rather than later because the only
# thing that matters is that it precedes the container.
sync
echo 1 > /proc/sys/vm/drop_caches
echo "dropped the page cache after the restore ($(free -g | awk '/^Mem:/ {print $NF}') GiB available)"

# ------------------------------------------------------------------
# 3b. Hand the run directories to the user the container runs as
#
# The image drops to etuser, and a bind mount keeps the host's ownership, so
# the directories created above -- and everything the restore just wrote --
# are root owned and mode 0755. The container would then fail on the first
# thing the run does, which is Cactus creating IOUtil::out_dir ("./data/").
# Verified against gw230529-et:local on 2026-08-20: uid 1000 cannot write a
# root owned 0755 bind mount.
#
# Phase 4 never hit this because the ops rehearsal writes its payload as root
# from this script and never enters the container.
#
# The uid is read from the image rather than written here, so that a rebuild
# which moves it fails loudly instead of quietly losing write access. It has
# to run after the restore: the sync above runs as root and would otherwise
# put root owned checkpoints back into a directory that had been handed over.
# ------------------------------------------------------------------
if [ "$${RUN_MODE}" = "simulation" ]; then
  CONTAINER_UID="$(docker run --rm "$${IMAGE}" id -u)"
  CONTAINER_GID="$(docker run --rm "$${IMAGE}" id -g)"
  case "$${CONTAINER_UID}:$${CONTAINER_GID}" in
    [0-9]*:[0-9]*) ;;
    *)
      echo "FATAL: could not read the container uid/gid from $${IMAGE}"
      exit 1
      ;;
  esac
  chown -R "$${CONTAINER_UID}:$${CONTAINER_GID}" \
    "$${WORK_DIR}/simulations" "$${WORK_DIR}/checkpoints"
  echo "run directories handed to uid $${CONTAINER_UID}:$${CONTAINER_GID}"
fi

# ------------------------------------------------------------------
# 4. Sidecar: periodic sync to S3
#
# Two design points, both driven by the Phase 2 measurement that a production
# checkpoint is about 78 GB across one file per MPI rank.
#
# Double buffering. A push-only mirror of every checkpoint generation would
# accumulate 76 generations over a 76 hour run -- 5.9 TB, roughly 31 USD until
# the lifecycle rule expires it, which is 10% of the project budget. Writing
# alternately into slot-a and slot-b holds S3 at two slots' worth instead --
# 312 GB at the default of two generations kept on the volume, since a push
# mirrors the whole directory into a slot.
#
# TODO(phase5): this bounds S3 only. Phase 2 found that IO::checkpoint_keep
# does not prune across runs -- two runs left three generations, 77 GB, on
# disk. At 78 GB each, a 500 GB root volume fills after six, which a run
# resumed a few times will reach. The sidecar needs to drop every local
# generation except the one CURRENT names and the one being written.
#
# The CURRENT marker. Uploading 78 GB takes minutes, and an instance reclaimed
# part way through leaves a torn set in S3. Without a marker, restore plus
# `recover = autoprobe` would select it precisely because it is the newest.
# The marker is written only after the upload returns success, so it always
# names a complete set.
#
# Output is pushed separately and additively: it only grows, and losing a
# diagnostic file matters far less than losing the ability to restart.
# ------------------------------------------------------------------
cat > /usr/local/bin/gw230529-sync <<SYNC
#!/usr/bin/env bash
set -euo pipefail
export AWS_DEFAULT_REGION="$${AWS_REGION}"

CKPT_DIR="$${WORK_DIR}/checkpoints"
S3_CKPT="$${S3_CKPT}"
KEEP=$${CHECKPOINT_GENERATIONS_KEPT}
RANKS=$${MPI_PROCS}
STAMP=/var/lib/gw230529/last-synced-checkpoint

# What "the checkpoint directory has not changed" means, in one place.
#
# It is asked twice on an ordinary tick -- once to decide whether to push,
# once to record what was pushed -- and a third time by --stamp-only after a
# restore. Two of those have to agree exactly or the tick that follows sees a
# difference and uploads a set that is already in S3, which is the whole of
# issue #11. A function is cheaper than the comment explaining why the three
# copies must be kept in step.
checkpoint_signature() {
  find "\$${CKPT_DIR}" -name '*.h5' -printf '%p %s %T@\n' 2>/dev/null | sort | sha256sum
}

write_stamp() {
  mkdir -p "\$(dirname "\$${STAMP}")"
  printf '%s' "\$(checkpoint_signature)" > "\$${STAMP}"
}

# Per-tick log.
#
# Everything this script prints used to reach only the journal, which dies
# with the instance. The single exception was the final tick, because section
# 8 calls the script directly and inherits the bootstrap log -- which is why
# the 2026-08-26 recovery test had to be reconstructed from S3 object
# timestamps rather than read off a log (#11).
#
# What was wanted and missing is the cost of a tick that does nothing. It
# still walks the output tree and lists a prefix, and on a node running
# np=192 on 192 cores with nothing spare, seconds spent there are not paid by
# one rank but by all of them at the next barrier. That is a candidate
# explanation for a recovered run measuring three times the sec/iter of the
# fresh one, and without a per-tick clock it cannot be told from the others.
#
# The file sits inside the tree this script syncs, so it reaches S3 on the
# next tick rather than this one, and it is additive across restarts for the
# same reason cactus-stdout.log is: the restore pulls output/ back first.
# It lives inside the run's own directory because that is where the sync is
# rooted now -- at simulations/ level it would never be uploaded, and two
# runs would interleave into one file.
#
# tee keeps the original stdout, so the final direct call still reports into
# the bootstrap log exactly as before.
TICK_LOG="$${WORK_DIR}/simulations/$${RUN_NAME}/sync.log"
mkdir -p "$${WORK_DIR}/simulations/$${RUN_NAME}"
exec > >(tee -a "\$${TICK_LOG}") 2>&1

# Same stamp format as section 0, so these lines pass through that stamper
# untouched on the final call instead of arriving wearing two timestamps.
say() { printf '[%s] %s\n' "\$(date -u +%Y-%m-%dT%H:%M:%SZ)" "\$*"; }

# SECONDS is elapsed time since this shell started, so every figure below is
# measured from the start of the tick.
say "tick start"
trap 'say "tick end after \$${SECONDS}s"' EXIT

# One sync at a time, however each was started (#15). systemd keeps the timer
# from overlapping itself, but section 8 and the spot watcher call this
# script directly, and on 2026-08-26 the final sync ran 13 seconds behind a
# timer tick -- two processes pushing the same slot, each with a --delete
# list the other could invalidate by pruning. Waiting rather than skipping,
# because the direct callers are the pushes that must not be dropped: a tick
# that queues behind the final sync finds nothing new and exits.
exec 9>>/var/lock/gw230529-sync.lock
if ! flock -n 9; then
  say "waiting for the lock held by another sync"
  flock 9
  say "lock acquired after \$${SECONDS}s"
fi

# --stamp-only: record the restored set as already synced, and push nothing.
#
# The bootstrap calls this once, after a restore. Without it the first
# ordinary tick finds no stamp, concludes that everything has changed, and
# re-uploads to the opposite slot the very set it has just downloaded --
# 162 GiB measured on 2026-08-26, and worse than merely wasteful, because it
# reads all of it back off the volume during the minutes Cactus is placing
# its memory (see section 3).
#
# Nothing is at risk while the stamp stands in for a push: the set it
# describes is the one CURRENT already names in S3. The first push happens
# when Cactus writes a generation that is genuinely new.
if [ "\$${1:-}" = "--stamp-only" ]; then
  write_stamp
  say "stamped the restored checkpoint set; the first tick will not re-upload it"
  exit 0
fi

# Diagnostic output first: cheap, additive, and never blocks a restart.
#
# The sync is rooted at the run's own directory, not at simulations/. That is
# what stops the run name appearing twice in every key (issue #5): the run
# directory inside simulations/ is already named after the run, so mirroring
# the parent would produce output/<run_name>/<run_name>/.
#
# CHECKPOINTS is excluded as a guard: it should be empty on the host because
# the checkpoint bind mount shadows it, but if that mount is ever missing the
# exclusion is what stops 78 GB being uploaded a second time under output/.
# Both patterns, because the exclusion is relative to the sync root and the
# directory sits directly under it.
aws s3 sync "$${WORK_DIR}/simulations/$${RUN_NAME}/" "$${S3_OUTPUT}/" \
  --exclude 'CHECKPOINTS/*' --exclude '*/CHECKPOINTS/*' --only-show-errors

# The bootstrap's own log with it. Everything that happens before Cactus
# starts -- the ECR pull, the two path rewrites, the uid handover -- is
# recorded only there, and the console output the EC2 API returns is a 64 KB
# tail, so on a node that has been up any length of time those lines are
# already gone. Without this, a bootstrap that failed leaves nothing to read.
#
# The key carries the instance id (#9). A relaunch under the same run_name --
# which is exactly how a spot interruption is resumed -- then lands beside
# the previous node's log instead of replacing it, and a log fetched during
# the minutes before this node's first push is absent rather than the
# previous run's content wearing a current face. Newest by run:
#   aws s3 ls <log_prefix> | sort | tail -1
#
# Never fatal: a missing log is not a reason to abandon a checkpoint push.
aws s3 cp /var/log/gw230529-bootstrap.log \
  "$${S3_LOGS}/bootstrap-$${INSTANCE_ID}.log" \
  --only-show-errors || true

# The unconditional part of every tick ends here. Everything after it is
# skipped unless a new checkpoint generation exists, so this figure is what
# the sidecar costs on a tick that finds nothing to do -- the number the
# interval has to be chosen against.
say "output and log pushed (\$${SECONDS}s)"

# Completeness. Syncing a set that Cactus is still writing is the one failure
# this whole design exists to prevent, so both halves have to hold: nothing
# written in the last 30 seconds, and the newest generation holding one file
# per rank. Naming confirmed on 2026-08-20 -- checkpoint.chkpt.it_<N>.file_<R>.h5,
# 32 of them at np=32.
#
# Quiescence alone is not enough. A writer that dies part way through leaves a
# set that stops changing while still missing ranks, and thirty seconds later
# this would push it and then point CURRENT at it -- an unrecoverable slot,
# arrived at by the very check meant to prevent one. The count is what makes
# the test positive rather than merely "nothing happened recently".
#
# When in doubt, skip: the next tick will handle it.
newest=\$(find "\$${CKPT_DIR}" -name '*.h5' -newermt '-30 seconds' -print -quit 2>/dev/null || true)
if [ -n "\$${newest}" ]; then
  say "checkpoint still being written; skipping this tick"
  exit 0
fi

newest_gen=\$(find "\$${CKPT_DIR}" -maxdepth 1 -name '*.h5' -printf '%f\n' 2>/dev/null \
  | grep -oE 'it_[0-9]+' | sort -u -t_ -k2 -n | tail -1 || true)
if [ -n "\$${newest_gen}" ]; then
  # The dots around the generation anchor it: "*.it_1.*" must not match
  # it_10 or it_16.
  have=\$(find "\$${CKPT_DIR}" -maxdepth 1 -name "*.\$${newest_gen}.*.h5" 2>/dev/null | wc -l)
  if [ "\$${have}" -ne "\$${RANKS}" ]; then
    say "generation \$${newest_gen} has \$${have} of \$${RANKS} files; skipping this tick"
    exit 0
  fi
fi

# Nothing new since the last successful push?
if [ -f "\$${STAMP}" ] && [ "\$(cat "\$${STAMP}")" = "\$(checkpoint_signature)" ]; then
  say "no new checkpoint generation since the last push"
  exit 0
fi

# Prune the local generations, before the push rather than after it.
#
# Safe because every generation dropped here is already in the slot that
# CURRENT names: that slot was written by the previous tick and still holds
# the set this volume had then. The restart point survives even if the push
# below never completes.
#
# Doing it after the push instead would work too, but the slot would then
# receive keep+1 generations every time and S3 residency would be half as
# large again for nothing.
#
# Cactus will not do this for us. IO::checkpoint_keep prunes within a run but
# not across restarts -- Phase 2 finished two runs with three generations and
# 77 GB on disk. At the production 78 GB per generation a 500 GB volume fills
# after six, which a run resumed a few times reaches, and the run then ends
# for want of space rather than for want of budget.
gens=\$(find "\$${CKPT_DIR}" -maxdepth 1 -name '*.h5' -printf '%f\n' 2>/dev/null \
  | grep -oE 'it_[0-9]+' | sort -u -t_ -k2 -n || true)
count=\$(printf '%s\n' "\$${gens}" | grep -c . || true)
if [ "\$${count}" -gt "\$${KEEP}" ]; then
  printf '%s\n' "\$${gens}" | head -n \$(( count - KEEP )) | while read -r g; do
    [ -n "\$${g}" ] || continue
    say "pruning local generation \$${g}"
    rm -f "\$${CKPT_DIR}"/*."\$${g}".*
  done
  say "kept \$${KEEP} of \$${count} generations on disk"
fi

current=\$(aws s3 cp "\$${S3_CKPT}/CURRENT" - 2>/dev/null || true)
if [ "\$${current}" = "slot-a" ]; then target=slot-b; else target=slot-a; fi

say "pushing checkpoints to \$${target}"
aws s3 sync "\$${CKPT_DIR}/" "\$${S3_CKPT}/\$${target}/" --delete --only-show-errors

# Only now is the slot known good.
printf '%s' "\$${target}" | aws s3 cp - "\$${S3_CKPT}/CURRENT" --only-show-errors
say "CURRENT is now \$${target}"
# Recompute rather than reuse the signature taken above: pruning changed the
# directory, and stamping the pre-prune set would leave the next tick seeing a
# difference and pushing the same generations again.
write_stamp
SYNC
chmod +x /usr/local/bin/gw230529-sync

# Tell the sidecar that what the restore brought down is already in S3, before
# the timer starts. Only after a restore: with no CURRENT marker the
# checkpoint directory is empty and there is nothing to describe.
if [ -n "$${CURRENT_SLOT}" ]; then
  /usr/local/bin/gw230529-sync --stamp-only
fi

cat > /etc/systemd/system/gw230529-sync.service <<UNIT
[Unit]
Description=Sync GW230529 checkpoints and output to S3

[Service]
Type=oneshot
ExecStart=/usr/local/bin/gw230529-sync
UNIT

cat > /etc/systemd/system/gw230529-sync.timer <<UNIT
[Unit]
Description=Periodic S3 sync for the GW230529 run

[Timer]
OnBootSec=$${SYNC_INTERVAL_MIN}min
OnUnitActiveSec=$${SYNC_INTERVAL_MIN}min
AccuracySec=1min

[Install]
WantedBy=timers.target
UNIT

# ------------------------------------------------------------------
# 5. Sidecar: heartbeat
#
# TODO(phase4): publish physical_time parsed from the Cactus stdout alongside
# the memory figures, so run progress is visible without opening a session.
# ------------------------------------------------------------------
cat > /usr/local/bin/gw230529-heartbeat <<HB
#!/usr/bin/env bash
set -euo pipefail
export AWS_DEFAULT_REGION="$${AWS_REGION}"
TOKEN=\$(curl -sX PUT http://169.254.169.254/latest/api/token \
  -H "X-aws-ec2-metadata-token-ttl-seconds: 60")
IID=\$(curl -sH "X-aws-ec2-metadata-token: \$${TOKEN}" \
  http://169.254.169.254/latest/meta-data/instance-id)
jq -n \
  --arg ts "\$(date -Is)" \
  --arg iid "\$${IID}" \
  --arg mem "\$(free -g | awk '/^Mem:/ {print \$3"/"\$2" GiB"}')" \
  --arg disk "\$(df -h $${WORK_DIR} | awk 'NR==2 {print \$5}')" \
  '{timestamp: \$ts, instance_id: \$iid, memory: \$mem, disk_used: \$disk}' \
  | aws s3 cp - "$${S3_HEARTBEAT}/latest.json" --only-show-errors
HB
chmod +x /usr/local/bin/gw230529-heartbeat

cat > /etc/systemd/system/gw230529-heartbeat.service <<UNIT
[Unit]
Description=Publish a GW230529 run heartbeat to S3

[Service]
Type=oneshot
ExecStart=/usr/local/bin/gw230529-heartbeat
UNIT

cat > /etc/systemd/system/gw230529-heartbeat.timer <<UNIT
[Unit]
Description=Periodic GW230529 heartbeat

[Timer]
OnBootSec=5min
OnUnitActiveSec=5min

[Install]
WantedBy=timers.target
UNIT

# ------------------------------------------------------------------
# 6. Sidecar: spot interruption watcher
#
# The warning gives roughly two minutes. A fresh 78 GB checkpoint can be
# neither written nor uploaded in that window, so the handler only flushes
# what is already on disk -- it must not ask Cactus for a new checkpoint.
#
# It runs the ordinary sync, which means it inherits the same refusal to
# upload a checkpoint set that is still being written. If Cactus happens to be
# mid-checkpoint when the notice arrives, the run falls back to the previous
# complete generation. Losing an hour of evolution beats restoring from a torn
# checkpoint and discovering it hours later.
# ------------------------------------------------------------------
cat > /usr/local/bin/gw230529-spot-watch <<WATCH
#!/usr/bin/env bash
set -euo pipefail
export AWS_DEFAULT_REGION="$${AWS_REGION}"
while true; do
  TOKEN=\$(curl -sX PUT http://169.254.169.254/latest/api/token \
    -H "X-aws-ec2-metadata-token-ttl-seconds: 60")
  CODE=\$(curl -so /dev/null -w '%%{http_code}' \
    -H "X-aws-ec2-metadata-token: \$${TOKEN}" \
    http://169.254.169.254/latest/meta-data/spot/instance-action)
  if [ "\$${CODE}" = "200" ]; then
    logger -t gw230529 "spot interruption notice received, flushing to S3"
    /usr/local/bin/gw230529-sync || true
    break
  fi
  sleep 5
done
WATCH
chmod +x /usr/local/bin/gw230529-spot-watch

cat > /etc/systemd/system/gw230529-spot-watch.service <<UNIT
[Unit]
Description=Flush the GW230529 run to S3 on a spot interruption warning

[Service]
Type=simple
Restart=always
ExecStart=/usr/local/bin/gw230529-spot-watch

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now gw230529-sync.timer
systemctl enable --now gw230529-heartbeat.timer
systemctl enable --now gw230529-spot-watch.service

# ------------------------------------------------------------------
# 7. Run
# ------------------------------------------------------------------
RUN_STATUS=0

if [ "$${RUN_MODE}" = "ops-rehearsal" ]; then
  # ----------------------------------------------------------------
  # Ops rehearsal: no physics.
  #
  # Phase 4 proves the operations loop -- slot rotation, the CURRENT marker,
  # interruption flush, restore -- and the Phase 2 numbers say a 16 GiB
  # instance cannot also do physics. The working set at dx=28 is 37.1 GB
  # measured; dx=33.6 still wants 21-26 GB; dx=67.2 fits but dies with
  # "GRHayL: u^0 evaluated to NaN" on the first evolution step, because the
  # CarpetRegrid2 radii are fixed in M and a coarser dx leaves level 1 with
  # 17 cells against the 62 the production grid has -- less than the ghost
  # zones and prolongation buffers consume.
  #
  # So this writes a payload shaped like a checkpoint set instead: one file
  # per rank, rewritten periodically, which is exactly what the sidecar has
  # to cope with. Cheap, interruptible at will, and it exercises every code
  # path that matters here.
  # ----------------------------------------------------------------
  echo "ops-rehearsal: $${REHEARSAL_GENERATIONS} generations of $${REHEARSAL_PAYLOAD_GB} GB"
  per_file_mb=$(( REHEARSAL_PAYLOAD_GB * 1024 / MPI_PROCS ))

  # Long enough that every generation gets at least one sidecar tick, plus a
  # minute so that a tick landing mid-write still has a later one to fall back
  # on. Derived rather than fixed: a rehearsal tuning the sync interval down
  # should not also have to remember to change this.
  gen_wait=$(( SYNC_INTERVAL_MIN * 60 + 60 ))

  for generation in $(seq 1 "$${REHEARSAL_GENERATIONS}"); do
    echo "rehearsal generation $${generation}: $${MPI_PROCS} files x $${per_file_mb} MB"

    # No rm. Cactus leaves the previous generation in place, and accumulation
    # is precisely what the sidecar's pruning exists to handle -- a rehearsal
    # that tidied up after itself would exercise the slot rotation and never
    # the pruning.
    for rank in $(seq 0 $(( MPI_PROCS - 1 ))); do
      dd if=/dev/urandom \
         of="$${WORK_DIR}/checkpoints/checkpoint.chkpt.it_$${generation}.file_$${rank}.h5" \
         bs=1M count="$${per_file_mb}" status=none
    done
    date -Is > "$${WORK_DIR}/simulations/$${RUN_NAME}/run/rehearsal.log"
    echo "on disk after generation $${generation}: $(du -sh "$${WORK_DIR}/checkpoints" | cut -f1)"
    echo "waiting $${gen_wait}s for the sidecar"
    sleep "$${gen_wait}"
  done
  echo "ops-rehearsal complete"
else
  # ----------------------------------------------------------------
  # Simulation.
  #
  # The checkpoint mount is nested inside the simulations mount so that it
  # lands exactly where the parfile's relative ../CHECKPOINTS resolves, while
  # staying a separate directory on the host. Do not "simplify" this by
  # dropping the inner mount: the sidecar would then treat 78 GB of
  # checkpoints as diagnostic output.
  #
  # The invocation is checked against the built image rather than assumed
  # (2026-08-20, gw230529-et:local):
  #
  #   cactus_sim is NOT on PATH. The image adds nothing to the distribution
  #   default, so a bare name resolves to nothing and the run would die on
  #   its first command. Hence the absolute CACTUS_EXE above.
  #
  #   mpirun.mpich rather than mpirun. Both reach mpiexec.hydra today, but
  #   /usr/bin/mpirun goes through /etc/alternatives/mpirun while
  #   /usr/bin/mpirun.mpich is a direct symlink. The image sets that
  #   alternative deliberately -- a mixed Open MPI / MPICH link was the Phase 1
  #   bug that made every rank believe it was rank 0 -- so the launcher should
  #   not depend on the alternatives database still being right.
  #
  # Phase 2 verified np=16 checkpoint writes with no POSIX lock errors and one
  # HDF5 file per rank, so the reference pure-MPI shape holds.
  # ----------------------------------------------------------------
  echo "simulation: $${IMAGE} parfile=$${PARFILE} np=$${MPI_PROCS} omp=$${OMP_THREADS}"

  # Cactus stdout is the run's primary instrument -- sec/iter, the memory
  # figures, and every Carpet warning appear there and nowhere else. Left as
  # it is it would reach only /var/log on a machine that exists to be
  # reclaimed, so it is teed into the run directory where the output sync
  # ships it to S3 on the same timer as everything else.
  #
  # Appending, not truncating: a run resumed after an interruption should read
  # as one log.
  #
  # `-b line` is what makes the stamps mean anything. C stdio buffers a pipe
  # in 4 KB blocks, and the evolution emits one info line every four
  # iterations -- around 200 bytes -- so a block covers roughly twenty lines.
  # Fully buffered, all twenty would leave the process together and be stamped
  # with the moment of the flush rather than the moment they were written,
  # which is minutes late and unevenly so. Line buffering costs one write
  # syscall per line at a rate of a few per minute.
  docker run --rm \
    --shm-size=8g \
    -e OMP_NUM_THREADS="$${OMP_THREADS}" \
    -v "$${WORK_DIR}/simulations:$${C_SIM_ROOT}" \
    -v "$${WORK_DIR}/checkpoints:$${C_CKPT_DIR}" \
    -v "$${WORK_DIR}/inputs:$${C_INPUTS}:ro" \
    -w "$${C_RUN_DIR}" \
    "$${IMAGE}" \
    mpirun.mpich -np "$${MPI_PROCS}" \
      "$${CACTUS_EXE}" -b line "$${C_INPUTS}/$${PARFILE}" 2>&1 \
    | stamp \
    | tee -a "$${WORK_DIR}/simulations/$${RUN_NAME}/run/cactus-stdout.log" \
    || RUN_STATUS=$?

  echo "simulation exited with status $${RUN_STATUS}"
fi

# ------------------------------------------------------------------
# 8. Final sync and self-termination
#
# instance_initiated_shutdown_behavior is "terminate", so the poweroff below
# ends billing. This is the real cost guard: budget alerts lag by 8-24 hours
# and cannot stop anything.
# ------------------------------------------------------------------
# Wait out the sync's quiescence window before the last push. The run has
# exited, so nothing can write to the checkpoint directory again -- but
# Cactus's final act is a termination checkpoint, which means the newest
# generation is always inside that window at this point and the push would
# skip it. Measured on 2026-08-20: a run that finished at iteration 64 pushed
# its output and left the it_64 checkpoint on a volume about to be deleted.
#
# It matters most where the run ends on purpose but is not finished -- a
# walltime cap, or a decision to stop and resume later -- because then the
# lost generation is exactly the one the next run would have started from.
# A spot interruption is unaffected: the watcher flushes whatever complete
# generation is already on disk, which is the design.
if [ "$${RUN_MODE}" = "simulation" ]; then
  echo "waiting out the checkpoint quiescence window before the final sync"
  sleep 45
fi

/usr/local/bin/gw230529-sync
echo "=== gw230529 bootstrap finished at $(date -Is), status=$${RUN_STATUS} ==="

if [ "$${AUTO_SHUTDOWN}" = "true" ]; then
  shutdown -h +1 "GW230529 run complete, terminating"
fi
