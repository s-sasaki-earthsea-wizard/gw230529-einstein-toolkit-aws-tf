# GW230529 AWS Terraform -- shell environment template
# Copy to `.env` and fill in. `.env` is gitignored.
#
# The Makefile sources this file, so it only needs values that are used by
# the AWS CLI / helper scripts. Terraform inputs live in the per-stack
# terraform.tfvars files instead.

# ============================================================
# AWS credentials
# ============================================================
# Named profile from ~/.aws/credentials or ~/.aws/config.
# Using a profile keeps long-lived keys out of the shell environment.
AWS_PROFILE=gw230529

# Region the foundation stack is deployed into.
# Fixed once and for all: ECR images and S3 objects are region-bound, so
# moving later means re-pushing the 5-8 GB image. Run `make region-scout`
# before deciding.
AWS_REGION=us-west-2

# ============================================================
# Region scouting
# ============================================================
# Candidate regions compared by scripts/region_scout.sh.
SCOUT_REGIONS="us-east-1 us-east-2 us-west-2"

# Instance types to score. The first entry is the production target.
#
# c7a.48xlarge  AMD Genoa. 192 vCPU = 192 physical cores, SMT disabled, and
#               12 DDR5 memory channels. The production target.
# m7a.48xlarge  Same cores, 768 GiB instead of 384 GiB, ~20-35% dearer.
#               The fallback when c7a capacity is unavailable.
# c7i.48xlarge  Intel Sapphire Rapids. 192 vCPU = 96 physical cores plus
#               hyperthreading, and 8 memory channels. Scored here only for
#               comparison -- half the real cores and less memory bandwidth
#               make it a poor fit for a bandwidth-bound evolution, whatever
#               the hourly price says.
SCOUT_INSTANCE_TYPES="c7a.48xlarge m7a.48xlarge c7i.48xlarge"

# Target capacity in vCPUs used for the spot placement score query.
SCOUT_TARGET_VCPUS=192

# ============================================================
# Terraform plugin cache
# ============================================================
# Shared provider download directory. The AWS provider is around 840 MB and
# all three stacks use it, so without a shared cache the checkout triples.
# The Makefile sets this automatically; override it here if the home
# directory is on slow storage.
# TF_PLUGIN_CACHE_DIR=${HOME}/.terraform.d/plugin-cache
